{
  "name": "@fringetools/cli",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "bin": {
    "fringe": "dist/bin.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "skill"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --dts --outDir dist --clean",
    "test": "vitest run",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "parse5": "^7.3.0",
    "postcss": "^8.5.31"
  },
  "description": "UX-quality checker for AI coding agents: accessibility, states, dark patterns, token drift, AI-look.",
  "keywords": [
    "accessibility",
    "a11y",
    "lint",
    "ux",
    "ai-agents",
    "claude-code"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/skc-learn/fringe.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/skc-learn/fringe#readme",
  "bugs": {
    "url": "https://github.com/skc-learn/fringe/issues"
  }
}
