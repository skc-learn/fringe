{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y @fringetools/cli@0.7.1 check --claude-hook",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y @fringetools/cli@0.7.1 hook-prompt",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
